# Copy to .env (gitignored) and fill in. Load before running:
#   set -a && source .env && set +a
#
# NOTE: Grafana base URLs and tokens are NOT set here. They live only in the environments
# config file, ~/.grafana-mcp-server/config.json — run `make config` to scaffold it, then
# edit in real values and keep it chmod 600. Every tool call names the environment it wants;
# there is no default. `list_grafana_environments` reports the file's path and shape.
#
#   {
#     "environments": {
#       "production": { "baseUrl": "https://grafana.example.com", "token": "glsa_…" },
#       "local":      { "baseUrl": "http://localhost:3000",       "token": "glsa_…" }
#     }
#   }
#
# Create the tokens in Grafana under Administration > Service accounts.

# Optional: put the environments config file somewhere other than ~/.grafana-mcp-server/config.json.
#GRAFANA_MCP_CONFIG=/path/to/config.json

# Optional: UID of a specific datasource to use. Leave unset and the first datasource of the
# needed type is discovered from /api/datasources on first use, per environment.
#GRAFANA_LOKI_DATASOURCE_UID=
#GRAFANA_PROMETHEUS_DATASOURCE_UID=
#GRAFANA_TEMPO_DATASOURCE_UID=
